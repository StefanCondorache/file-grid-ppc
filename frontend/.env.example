# Copy to .env.local for development. Nothing here is secret; all NEXT_PUBLIC_* values ship to the browser.
# API prefix (proposal /api/v1; the NestJS skeleton uses /api).
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_APP_VERSION=dev
# Optional deep link for "Deschide în Grafana".
NEXT_PUBLIC_GRAFANA_URL=
# Development only: where `next dev` proxies /api.
API_DEV_PROXY_TARGET=http://localhost:8000
