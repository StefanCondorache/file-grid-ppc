# Copy to .env.local for development. Nothing here is secret; all NEXT_PUBLIC_* values ship to the browser.
# 1 = MSW mocks (default in development/test), 0 = real NestJS backend.
NEXT_PUBLIC_API_MOCKS=1
# Optional: mock only these groups (hybrid, in-page). Never uploads or files. Empty = all.
NEXT_PUBLIC_API_MOCK_GROUPS=
# API prefix (proposal /api/v1; the NestJS skeleton uses /api).
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_APP_VERSION=dev
# Optional deep link for "Deschide în Grafana".
NEXT_PUBLIC_GRAFANA_URL=
# Build-time only: allow a production build with mocks (demo-day fallback image).
FILEGRID_ALLOW_MOCKS=0
# Development only: where `next dev` proxies /api.
API_DEV_PROXY_TARGET=http://localhost:3001
