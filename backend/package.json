{
  "name": "filegrid-backend",
  "version": "0.1.0",
  "description": "FileGrid PPC backend: routes files to S3, FTP or DB storage by per-category policy",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.0",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.11.0-beta.19",
    "jest": "30.5.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.11.0-beta.19": true
  }
}
