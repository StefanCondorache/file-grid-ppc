# Backend settings. In Docker/k3s they come from the environment; for local runs copy this
# file to backend/.env (git-ignored) and replace every change-me.
DATABASE_URL=postgresql://filegrid:change-me@127.0.0.1:5432/filegrid
JWT_SECRET=change-me-use-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me
# Comma-separated; each key at least 16 characters. The meter simulator sends one as X-API-Key.
METER_API_KEYS=change-me-meter-key-0001
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
