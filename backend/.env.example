# Backend settings (names match the k3s Secrets filegrid-storage-credentials and filegrid-app-secrets,
# see the README "Contracte pentru P2/P3"). For local runs copy to backend/.env (git-ignored) and
# replace every change-me. Never commit real values.
PORT=8000
# Metadata DB = the same PostgreSQL as the db storage (or set FILEGRID_PG_DSN).
FILEGRID_PG_HOST=127.0.0.1
FILEGRID_PG_PORT=5432
POSTGRES_USER=filegrid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filegrid
# Start-up: retry an unreachable database (DNS, connection) for this long, then exit (default 90).
FILEGRID_DB_BOOT_TIMEOUT_S=90
# SIGTERM: in-flight requests may take this long to finish before the DB pool closes (default 20).
FILEGRID_SHUTDOWN_DRAIN_S=20
# Storages (read by src/storage/config.ts)
FILEGRID_S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=filegrid
FILEGRID_FTP_HOST=127.0.0.1
FILEGRID_FTP_PORT=21
FTP_USER=filegrid
FTP_PASSWORD=change-me
# memory = all three storages in process memory (no S3/FTP needed; data is lost on restart)
FILEGRID_STORAGE_DRIVER=real
# App secrets
JWT_SECRET=change-me-use-at-least-32-random-characters
METER_API_KEY=change-me-meter-key-0001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# base64 of 32 random bytes: openssl rand -base64 32
FILEGRID_KEK=change-me
FILEGRID_KEK_ID=k1
# Plain-HTTP local runs need COOKIE_SECURE=false (the cookie is then fg_session, not __Host-fg_session)
COOKIE_SECURE=true
FILEGRID_DEMO_MODE=true
SIMULATOR_URL=http://127.0.0.1:8080
LOG_LEVEL=info
