# Template. infra/gen-env.sh copies it to infra/.env (git-ignored) with random secrets replacing change-me.
POSTGRES_DB=filegrid
POSTGRES_USER=filegrid
POSTGRES_PASSWORD=change-me

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=filegrid

FTP_USER=filegrid
FTP_PASSWORD=change-me

# Endpoints (not secret) for the app on the laptop; in k3s the same keys come from ConfigMap
# filegrid-storage-endpoints (namespace filegrid).
FILEGRID_PG_HOST=127.0.0.1
FILEGRID_PG_PORT=5432
FILEGRID_S3_ENDPOINT=http://127.0.0.1:9000
FILEGRID_FTP_HOST=127.0.0.1
FILEGRID_FTP_PORT=21
